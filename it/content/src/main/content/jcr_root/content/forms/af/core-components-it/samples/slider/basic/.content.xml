<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:fd="http://www.adobe.com/aemfd/fd/1.0"
          jcr:primaryType="cq:Page">
    <jcr:content
            cq:deviceGroups="[mobile/groups/responsive]"
            cq:template="/conf/core-components-examples/settings/wcm/templates/af-blank-v2"
            jcr:language="en"
            jcr:primaryType="cq:PageContent"
            jcr:title="Adaptive Form V2 (IT)"
            sling:configRef="/conf/forms/core-components-it/samples/slider/basic/"
            sling:resourceType="forms-components-examples/components/page">
        <guideContainer
                fd:version="2.1"
                jcr:primaryType="nt:unstructured"
                sling:resourceType="forms-components-examples/components/form/container"
                dorType="none"
                fieldType="form"
                schemaType="none"
                textIsRich="true"
                thankYouMessage="Thank you for submitting the form."
                thankYouOption="page"
                themeRef="/libs/fd/af/themes/canvas">
            <slider1
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Slider 1"
                    sling:resourceType="forms-components-examples/components/form/slider"
                    fieldType="range"
                    type="number"
                    name="slider1"
                    minimum="0"
                    maximum="100"
                    step="5"
                    default="20"/>
            <slider2
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Slider 2"
                    sling:resourceType="forms-components-examples/components/form/slider"
                    fieldType="range"
                    type="number"
                    name="slider2"
                    minimum="10"
                    maximum="50"
                    step="10"/>
            <slider3
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Slider 3 (read-only)"
                    sling:resourceType="forms-components-examples/components/form/slider"
                    fieldType="range"
                    type="number"
                    name="slider3"
                    minimum="0"
                    maximum="10"
                    step="1"
                    default="3"
                    readOnly="{Boolean}true"/>
            <slider4
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Slider 4 (disabled)"
                    sling:resourceType="forms-components-examples/components/form/slider"
                    fieldType="range"
                    type="number"
                    name="slider4"
                    minimum="0"
                    maximum="10"
                    step="1"
                    default="4"
                    enabled="{Boolean}false"/>
            <slider5
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Slider 5 (with help)"
                    sling:resourceType="forms-components-examples/components/form/slider"
                    fieldType="range"
                    type="number"
                    name="slider5"
                    minimum="0"
                    maximum="100"
                    step="1"
                    description="This is long description"
                    tooltip="This is short description"
                    tooltipVisible="true"
                    id="tooltip_scenario_test"/>
            <numberinput1
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Total (calculated from Slider 1)"
                    sling:resourceType="forms-components-examples/components/form/numberinput"
                    fieldType="number-input"
                    type="number"
                    name="total"
                    readOnly="{Boolean}true">
                <fd:rules
                        jcr:primaryType="nt:unstructured"
                        value="$form.slider1.$value * 2"/>
            </numberinput1>
        </guideContainer>
    </jcr:content>
</jcr:root>
