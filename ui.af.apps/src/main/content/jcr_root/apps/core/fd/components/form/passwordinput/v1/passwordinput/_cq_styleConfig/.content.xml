<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Base">
    <items jcr:primaryType="nt:unstructured">
        <field jcr:primaryType="nt:unstructured">
            <items jcr:primaryType="nt:unstructured">
                <widgetAndText
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Password"
                    cssSelector=".cmp-adaptiveform-passwordinput"
                    id="af2_passwordinputwidgetandtext"
                    longTitle="Password Widget"
                    propertySheet="/mnt/overlay/fd/af/components/stylePropertySheet/common"
                    secondarySelectors="af2_guideContainer:af2_widgetAndText">
                    <items jcr:primaryType="nt:unstructured">
                        <passwordLabelContainer
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Label Container"
                                id="af2_passwordlabelcontainer"
                                cssSelector=".cmp-adaptiveform-passwordinput__label-container"
                                longTitle="Password Label Container"
                                propertySheet="/mnt/overlay/fd/af/components/stylePropertySheet/common">
                            <items jcr:primaryType="nt:unstructured">
                                <passwordLabel
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Label"
                                    id="af2_passwordlabel"
                                    cssSelector=".cmp-adaptiveform-passwordinput__label-container .cmp-adaptiveform-passwordinput__label"
                                    longTitle="Password Label"
                                    propertySheet="/mnt/overlay/fd/af/components/stylePropertySheet/common">
                                    <states jcr:primaryType="nt:unstructured">
                                        <hover
                                            jcr:primaryType="nt:unstructured"
                                            jcr:title="Hover"
                                            cssSelector=".cmp-adaptiveform-passwordinput__label-container .cmp-adaptiveform-passwordinput__label:hover"/>
                                        <focus
                                            jcr:primaryType="nt:unstructured"
                                            jcr:title="Focus"
                                            cssSelector=".cmp-adaptiveform-passwordinput__label-container .cmp-adaptiveform-passwordinput__label:focus"/>
                                    </states>
                                </passwordLabel>
                                <passwordHelpIcon
                                        jcr:primaryType="nt:unstructured"
                                        jcr:title="Help Icon"
                                        id="af2_passwordhelpicon"
                                        cssSelector=".cmp-adaptiveform-passwordinput__label-container .cmp-adaptiveform-passwordinput__questionmark"
                                        longTitle="Password Help Icon"
                                        propertySheet="/mnt/overlay/fd/af/components/stylePropertySheet/common"
                                        secondarySelectors="af2_guideContainer:af2_helpicon">
                                    <states jcr:primaryType="nt:unstructured">
                                        <focus
                                            jcr:primaryType="nt:unstructured"
                                            jcr:title="Focus"
                                            cssSelector=".cmp-adaptiveform-passwordinput__label-container .cmp-adaptiveform-passwordinput__questionmark:focus"/>
                                        <hover
                                            jcr:primaryType="nt:unstructured"
                                            jcr:title="Hover"
                                            cssSelector=".cmp-adaptiveform-passwordinput__label-container .cmp-adaptiveform-passwordinput__questionmark:hover"/>
                                        <disabled
                                            jcr:primaryType="nt:unstructured"
                                            jcr:title="Disabled"
                                            cssSelector=".cmp-adaptiveform-passwordinput__label-container .cmp-adaptiveform-passwordinput__questionmark:disabled"/>
                                    </states>
                                </passwordHelpIcon>
                            </items>
                            <states jcr:primaryType="nt:unstructured">
                                <disabled
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Disabled"
                                    cssSelector=".cmp-adaptiveform-passwordinput__label-container:disabled"/>
                                <hover
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Hover"
                                    cssSelector=".cmp-adaptiveform-passwordinput__label-container:hover"/>
                                <focus
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Focus"
                                    cssSelector=".cmp-adaptiveform-passwordinput__label-container:focus"/>
                            </states>
                        </passwordLabelContainer>
                        <passwordWidgetAndText
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Password"
                            id="af2_passwordwidgetandtext"
                            cssSelector=".cmp-adaptiveform-passwordinput__widget"
                            longTitle="Password Widget"
                            propertySheet="/mnt/overlay/fd/af/components/stylePropertySheet/common"
                            secondarySelectors="af2_guideContainer:af2_widgetAndText">
                            <states jcr:primaryType="nt:unstructured">
                                <focus
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Focus"
                                    cssSelector=".cmp-adaptiveform-passwordinput__widget:focus"/>
                                <hover
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Hover"
                                    cssSelector=".cmp-adaptiveform-passwordinput__widget:hover"/>
                                <disabled
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Disabled"
                                    cssSelector=".cmp-adaptiveform-passwordinput__widget:disabled"/>
                                <mandatory
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Mandatory"
                                    cssSelector=".cmp-adaptiveform-passwordinput__widget:required"/>
                            </states>
                        </passwordWidgetAndText>
                        <passwordToggleVisibility
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Show/Hide Toggle"
                            id="af2_passwordtogglevisibility"
                            cssSelector=".cmp-adaptiveform-passwordinput__toggle-visibility"
                            longTitle="Password Show/Hide Toggle"
                            propertySheet="/mnt/overlay/fd/af/components/stylePropertySheet/common">
                            <states jcr:primaryType="nt:unstructured">
                                <focus
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Focus"
                                    cssSelector=".cmp-adaptiveform-passwordinput__toggle-visibility:focus"/>
                                <hover
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Hover"
                                    cssSelector=".cmp-adaptiveform-passwordinput__toggle-visibility:hover"/>
                                <disabled
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Disabled"
                                    cssSelector=".cmp-adaptiveform-passwordinput__toggle-visibility:disabled"/>
                            </states>
                        </passwordToggleVisibility>
                        <passwordDescriptionShort
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Short Description"
                                id="af2_passworddescriptionshort"
                                cssSelector=".cmp-adaptiveform-passwordinput__shortdescription"
                                longTitle="Password Short Description"
                                propertySheet="/mnt/overlay/fd/af/components/stylePropertySheet/common">
                        </passwordDescriptionShort>
                        <passwordDescriptionLong
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Long Description"
                                id="af2_passworddescriptionlong"
                                cssSelector=".cmp-adaptiveform-passwordinput__longdescription"
                                longTitle="Password Long Description"
                                propertySheet="/mnt/overlay/fd/af/components/stylePropertySheet/common">
                    <items jcr:primaryType="nt:unstructured">
                        <longDescriptionParagraph
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Long Description Paragraph"
                                id="af2_passworddescriptionlongparagraph"
                                cssSelector=".cmp-adaptiveform-passwordinput__longdescription p"
                                longTitle="Long Description Paragraph"
                                propertySheet="/mnt/overlay/fd/af/components/stylePropertySheet/common"/>
                    </items>
                            <states jcr:primaryType="nt:unstructured">
                                <focus
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Focus"
                                    cssSelector=".cmp-adaptiveform-passwordinput__longdescription:focus"/>
                                <hover
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Hover"
                                    cssSelector=".cmp-adaptiveform-passwordinput__longdescription:hover"/>
                            </states>
                        </passwordDescriptionLong>
                        <passwordErrorMessage
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Password Error Message"
                                id="af2_passworderrormessage"
                                cssSelector=".cmp-adaptiveform-passwordinput__errormessage"
                                longTitle="Password Error Message"
                                propertySheet="/mnt/overlay/fd/af/components/stylePropertySheet/common">
                        </passwordErrorMessage>
                    </items>
                    <states jcr:primaryType="nt:unstructured">
                        <focus
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Focus"
                                cssSelector=".cmp-adaptiveform-passwordinput:focus"/>
                        <disabled
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Disabled"
                                cssSelector=".cmp-adaptiveform-passwordinput[data-cmp-enabled='false']"/>
                        <hover
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Hover"
                                cssSelector=".cmp-adaptiveform-passwordinput:hover"/>
                        <mandatory
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Mandatory"
                                cssSelector=".cmp-adaptiveform-passwordinput[data-cmp-required='true']"/>
                        <error
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Error"
                                cssSelector=".cmp-adaptiveform-passwordinput[data-cmp-valid='false']"/>
                        <success
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Success"
                                cssSelector=".cmp-adaptiveform-passwordinput[data-cmp-valid='true']"/>
                    </states>
                </widgetAndText>
                <textAreaWidgetAndText
                    jcr:primaryType="nt:unstructured"
                    sling:hideResource="{Boolean}true"/>
            </items>
        </field>
    </items>
</jcr:root>
