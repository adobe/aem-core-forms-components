<!--
  Basic tab mirrors the foundation adobeSignBlock dialog:
    Name | Bind Reference | Hide Object | CSS Class | Title | Hide title

  Inheritance chain: adobesignblock → text/v1/text → base/v1/base
  text/v1/text hides title, richTextTitle, isTitleRichText, hideTitle,
  enabled, enabled-typehint, readonly, dorBindref, placeholder.
  We restore title, hideTitle, and bindref; add cssClass; hide inapplicable fields.
-->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Adobe Sign Block"
          sling:resourceType="cq/gui/components/authoring/dialog"
          extraClientlibs="[core.forms.components.adobesignblock.v1.editor]"
          helpPath="https://www.adobe.com/go/aem_af_cmp_adobesignblock_v1"
          trackingFeature="core-components:adaptiveform-adobesignblock:v1">
    <content
            granite:class="cmp-adaptiveform-adobesignblock__editdialog"
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/tabs"
                    maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <basic
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Basic"
                            sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">

                                            <!--
                                              Restore title — text/v1/text hides this; providing a definition
                                              without sling:hideResource overrides that hide.
                                            -->
                                            <title
                                                    jcr:primaryType="nt:unstructured"
                                                    granite:class="cmp-adaptiveform-base__title"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldLabel="Title"
                                                    name="./jcr:title"/>

                                            <!-- Restore hideTitle for the same reason -->
                                            <hideTitle
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                    name="./hideTitle"
                                                    text="Hide title"
                                                    uncheckedValue="false"
                                                    value="true"/>

                                            <!-- Fields not applicable to this display-only component -->
                                            <placeholder
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <richTextTitle
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <isTitleRichText
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <enabled
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <enabled-typehint
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <readonly
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <readonly-typehint
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <dorBindref
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <unboundFormElement
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <unboundFormElement-typehint
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <!--
                                              bindref (Bind reference) and visible (Hide component) are inherited
                                              from base/v1/base and neither ancestor hides them - hide both here.
                                            -->
                                            <bindref
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <visible
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <visible-typehint
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </basic>
                    <adobeSignField
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Adobe Sign Field"
                            sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <richText
                                                    jcr:primaryType="nt:unstructured"
                                                    wrapperClass="cmp-adaptiveform-adobesignblock__richtext"
                                                    sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                                    fieldLabel="Label shown before the Adobe Sign field placeholder"
                                                    name="./value"
                                                    useFixedInlineToolbar="{Boolean}true">
                                                <rtePlugins jcr:primaryType="nt:unstructured">
                                                    <format
                                                            jcr:primaryType="nt:unstructured"
                                                            features="*"/>
                                                    <lists
                                                            jcr:primaryType="nt:unstructured"
                                                            features="*"/>
                                                    <justify
                                                            jcr:primaryType="nt:unstructured"
                                                            features="*"/>
                                                    <links jcr:primaryType="nt:unstructured">
                                                        <linkDialogConfig
                                                                jcr:primaryType="nt:unstructured"
                                                                height="{Long}316">
                                                            <linkAttributes jcr:primaryType="cq:WidgetCollection"/>
                                                        </linkDialogConfig>
                                                    </links>
                                                    <paraformat
                                                            jcr:primaryType="nt:unstructured"
                                                            features="*"/>
                                                    <fullscreen
                                                            jcr:primaryType="nt:unstructured"
                                                            features="*"/>
                                                </rtePlugins>
                                                <uiSettings jcr:primaryType="nt:unstructured">
                                                    <cui jcr:primaryType="nt:unstructured">
                                                        <inline
                                                                jcr:primaryType="nt:unstructured"
                                                                toolbar="[#format,-,#justify,-,#lists,-,links#modifylink,links#unlink,-,fullscreen#start]">
                                                            <popovers jcr:primaryType="nt:unstructured">
                                                                <justify
                                                                        jcr:primaryType="nt:unstructured"
                                                                        items="[justify#justifyleft,justify#justifycenter,justify#justifyright]"
                                                                        ref="justify"/>
                                                                <lists
                                                                        jcr:primaryType="nt:unstructured"
                                                                        items="[lists#unordered,lists#ordered,lists#outdent,lists#indent]"
                                                                        ref="lists"/>
                                                                <format
                                                                        jcr:primaryType="nt:unstructured"
                                                                        items="[format#bold,format#italic,format#underline]"
                                                                        ref="format"/>
                                                            </popovers>
                                                        </inline>
                                                    </cui>
                                                </uiSettings>
                                            </richText>

                                            <!--
                                              Reuse integration-adobesign's own RTE-dialog field set (Type, Name,
                                              Min/Max, Options, per-type Default Value, Radio Style, Mask, Multi
                                              Line, Tooltip, Required) verbatim via include, instead of
                                              re-implementing its per-type show/hide logic here. editDialog.js
                                              bootstraps window.adobesign.dialog.plugin against this included markup.
                                            -->
                                            <adobeSignFieldSettings
                                                    jcr:primaryType="nt:unstructured"
                                                    granite:class="cmp-adaptiveform-adobesignblock__fieldsettings"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <include
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/include"
                                                            path="/libs/adobesign/components/rte/dialogcontainer/items/columnContainer/items/column"/>
                                                </items>
                                            </adobeSignFieldSettings>
                                            <adobeSignFieldTag
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                                    name="./adobeSignFieldTag"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </adobeSignField>
                    <!-- Validation, Formats, and Document of Record tabs not relevant for this component -->
                    <validation
                            jcr:primaryType="nt:unstructured"
                            sling:hideResource="{Boolean}true"/>
                    <patterns
                            jcr:primaryType="nt:unstructured"
                            sling:hideResource="{Boolean}true"/>
                    <dor
                            jcr:primaryType="nt:unstructured"
                            sling:hideResource="{Boolean}true"/>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
