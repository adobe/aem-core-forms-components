<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Adaptive Form Password Input field"
    sling:resourceType="cq/gui/components/authoring/dialog"
    helpPath="https://www.adobe.com/go/aem_af_cmp_passwordinput_v1"
    trackingFeature="core-components:adaptiveform-passwordinput:v1">
    <content
        granite:class="cmp-adaptiveform-passwordinput__editdialog"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                  jcr:primaryType="nt:unstructured"
                  sling:resourceType="granite/ui/components/coral/foundation/tabs"
                  maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <basic
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Basic"
                            sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <value
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <multiLine
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <autocomplete
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <autocomplete-password
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                    fieldLabel="Autofill attribute"
                                                    forceSelection="{Boolean}true"
                                                    name="./autocomplete"
                                                    value="new-password">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <empty
                                                            jcr:primaryType="nt:unstructured"
                                                            text=""
                                                            value=""/>
                                                    <off
                                                            jcr:primaryType="nt:unstructured"
                                                            text="off"
                                                            value="off"/>
                                                    <new_x0020_password
                                                            jcr:primaryType="nt:unstructured"
                                                            text="new-password"
                                                            value="new-password"
                                                            selected="{Boolean}true"/>
                                                    <current_x0020_password
                                                            jcr:primaryType="nt:unstructured"
                                                            text="current-password"
                                                            value="current-password"/>
                                                </items>
                                            </autocomplete-password>
                                            <showHidePassword
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                    fieldDescription="Let users toggle the field between masked and plain text."
                                                    name="./showHidePassword"
                                                    text="Allow showing/hiding the password"
                                                    checked="{Boolean}true"
                                                    value="true"
                                                    uncheckedValue="false"/>
                                            <fieldType
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                    name="./fieldType"
                                                    required="{Boolean}true"
                                                    granite:hidden="true">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <item jcr:primaryType="nt:unstructured"
                                                          text="Password Input"
                                                          value="password"
                                                          selected="{Boolean}true"/>
                                                </items>
                                            </fieldType>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </basic>
                    <validation
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <validationPatternGroup
                                                    jcr:primaryType="nt:unstructured"
                                                    jcr:title="Validation Pattern"
                                                    sling:resourceType="fd/af/authoring/components/granite/form/fieldset"
                                                    title="Validation Pattern">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <validationPatternType
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:hideResource="{Boolean}true">
                                                        <datasource
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:hideResource="{Boolean}true"/>
                                                    </validationPatternType>
                                                    <validateFormat
                                                            jcr:primaryType="nt:unstructured"
                                                            granite:class="cmp-adaptiveform-passwordinput__validationformat"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldDescription="Regular Expression is permitted, e.g. to require a digit and a symbol."
                                                            fieldLabel="Pattern"
                                                            name="./pattern">
                                                    </validateFormat>
                                                    <validatePictureClauseMessage
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                            fieldLabel="Error Message"
                                                            name="./validatePictureClauseMessage"/>
                                                    <formatMessage
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                                            name="./formatMessage@ValueFrom"
                                                            value="./validatePictureClauseMessage"/>
                                                </items>
                                            </validationPatternGroup>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </validation>
                    <patterns
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Formats"
                            granite:hide="{Boolean}true"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                        </items>
                    </patterns>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
