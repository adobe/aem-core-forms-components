<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Adaptive Form Slider field"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[core.forms.components.slider.v1.editor]"
    trackingFeature="core-components:adaptiveform-slider:v1">
    <content
        granite:class="cmp-adaptiveform-slider__editdialog"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                  jcr:primaryType="nt:unstructured"
                  sling:resourceType="granite/ui/components/coral/foundation/tabs"
                  maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <basic
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Basic"
                            sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <placeholder
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <minimum
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                    granite:class="cmp-adaptiveform-slider__minimum"
                                                    fieldLabel="Minimum value"
                                                    fieldDescription="Lowest value of the slider. Must be less than the maximum value."
                                                    step="any"
                                                    required="{Boolean}true"
                                                    name="./minimum"/>
                                            <maximum
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                    granite:class="cmp-adaptiveform-slider__maximum"
                                                    fieldLabel="Maximum value"
                                                    fieldDescription="Highest value of the slider."
                                                    step="any"
                                                    required="{Boolean}true"
                                                    name="./maximum"/>
                                            <step
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                    granite:class="cmp-adaptiveform-slider__step"
                                                    fieldLabel="Step"
                                                    fieldDescription="Granularity of the slider. Must be greater than 0."
                                                    min="0"
                                                    step="any"
                                                    name="./step"/>
                                            <default
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                    granite:class="cmp-adaptiveform-slider__default"
                                                    fieldLabel="Default value"
                                                    fieldDescription="Initial value. Must be within the range and on a step."
                                                    step="any"
                                                    name="./default"/>
                                            <fieldType
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                    name="./fieldType"
                                                    required="{Boolean}true"
                                                    granite:hidden="true">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <item jcr:primaryType="nt:unstructured"
                                                          text="Slider"
                                                          value="range"
                                                          selected="{Boolean}true"/>
                                                </items>
                                            </fieldType>
                                            <type
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                                    name="./type"
                                                    value="number"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </basic>
                    <validation
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Validation"
                            sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <validateExpMessage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:hideResource="{Boolean}true"/>
                                            <minimumMessage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                    fieldDescription="Error message shown when the value is less than the minimum."
                                                    fieldLabel="Minimum error message"
                                                    name="./minimumMessage"/>
                                            <maximumMessage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                    fieldDescription="Error message shown when the value is more than the maximum."
                                                    fieldLabel="Maximum error message"
                                                    name="./maximumMessage"/>
                                            <stepMessage
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                    fieldDescription="Error message shown when the value is not a multiple of the step."
                                                    fieldLabel="Step error message"
                                                    name="./stepMessage"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </validation>
                    <help
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Help Content"
                            sling:resourceType="granite/ui/components/coral/foundation/container"/>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
